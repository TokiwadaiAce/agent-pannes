<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://example.com/maintenance">
  <bpmn:collaboration id="Collab_1">
    <bpmn:participant id="Pool_1" name="Analyse des pannes de maintenance" processRef="Process_1" />
    <bpmn:textAnnotation id="Note_1">
      <bpmn:text>Tous les calculs (temps d'arrêt, top 3, récurrences ≥ 3) sont faits par le code, jamais par le LLM</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_1" sourceRef="S3" targetRef="Note_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Tech" name="Technicien de maintenance">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Code" name="Script (code déterministe)">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Agent" name="Agent IA (LLM)">
        <bpmn:flowNodeRef>A1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Resp" name="Responsable maintenance">
        <bpmn:flowNodeRef>R1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Intervention terminée">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="T1" name="Saisir l'intervention (machine, ligne, description, durée d'arrêt)">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="T2" name="Exporter le journal en CSV">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:scriptTask id="S1" name="Lire le CSV et la liste des catégories, valider les champs">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:serviceTask id="A1" name="Classer chaque panne dans une catégorie (liste fermée)">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:scriptTask id="S2" name="Rejeter les catégories hors liste, écrire le CSV enrichi">
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="S3" name="Calculer : arrêts par machine et catégorie, top 3, pannes répétées ≥ 3">
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:serviceTask id="A2" name="Rédiger le bilan par machine et les pistes préventives (à étudier)">
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:scriptTask id="S4" name="Comparer les chiffres cités aux chiffres calculés">
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="G1" name="Chiffres cohérents ?">
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
      <bpmn:outgoing>f11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="S5" name="Générer la note de revue (.md)">
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>f12</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:userTask id="R1" name="Lire le bilan et décider des études à lancer">
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:outgoing>f13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_1" name="Bilan livré">
      <bpmn:incoming>f13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="Start_1" targetRef="T1" />
    <bpmn:sequenceFlow id="f2" sourceRef="T1" targetRef="T2" />
    <bpmn:sequenceFlow id="f3" sourceRef="T2" targetRef="S1" />
    <bpmn:sequenceFlow id="f4" sourceRef="S1" targetRef="A1" />
    <bpmn:sequenceFlow id="f5" sourceRef="A1" targetRef="S2" />
    <bpmn:sequenceFlow id="f6" sourceRef="S2" targetRef="S3" />
    <bpmn:sequenceFlow id="f7" sourceRef="S3" targetRef="A2" />
    <bpmn:sequenceFlow id="f8" sourceRef="A2" targetRef="S4" />
    <bpmn:sequenceFlow id="f9" sourceRef="S4" targetRef="G1" />
    <bpmn:sequenceFlow id="f10" name="Oui" sourceRef="G1" targetRef="S5" />
    <bpmn:sequenceFlow id="f11" name="Non : réécrire" sourceRef="G1" targetRef="A2" />
    <bpmn:sequenceFlow id="f12" sourceRef="S5" targetRef="R1" />
    <bpmn:sequenceFlow id="f13" sourceRef="R1" targetRef="End_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Collab_1">
      <bpmndi:BPMNShape id="Pool_1_di" bpmnElement="Pool_1" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="2040" height="600" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Tech_di" bpmnElement="Lane_Tech" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="2010" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Code_di" bpmnElement="Lane_Code" isHorizontal="true">
        <dc:Bounds x="190" y="230" width="2010" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Agent_di" bpmnElement="Lane_Agent" isHorizontal="true">
        <dc:Bounds x="190" y="380" width="2010" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Resp_di" bpmnElement="Lane_Resp" isHorizontal="true">
        <dc:Bounds x="190" y="530" width="2010" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_1_di" bpmnElement="Start_1">
        <dc:Bounds x="232" y="137" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="212" y="180" width="76" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T1_di" bpmnElement="T1">
        <dc:Bounds x="310" y="115" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T2_di" bpmnElement="T2">
        <dc:Bounds x="470" y="115" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S1_di" bpmnElement="S1">
        <dc:Bounds x="630" y="265" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A1_di" bpmnElement="A1">
        <dc:Bounds x="790" y="415" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S2_di" bpmnElement="S2">
        <dc:Bounds x="950" y="265" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S3_di" bpmnElement="S3">
        <dc:Bounds x="1110" y="265" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A2_di" bpmnElement="A2">
        <dc:Bounds x="1270" y="415" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S4_di" bpmnElement="S4">
        <dc:Bounds x="1430" y="265" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G1_di" bpmnElement="G1" isMarkerVisible="true">
        <dc:Bounds x="1595" y="280" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1580" y="250" width="80" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S5_di" bpmnElement="S5">
        <dc:Bounds x="1730" y="265" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="R1_di" bpmnElement="R1">
        <dc:Bounds x="1890" y="565" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_1_di" bpmnElement="End_1">
        <dc:Bounds x="2082" y="587" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="2068" y="630" width="64" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Note_1_di" bpmnElement="Note_1">
        <dc:Bounds x="1010" y="570" width="300" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1">
        <di:waypoint x="268" y="155" /><di:waypoint x="310" y="155" />
      </bpmndi:BPMNEdge>
